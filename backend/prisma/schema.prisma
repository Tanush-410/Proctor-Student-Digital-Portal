generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (pgbouncer, port 6543) — what the running app uses for
  // ordinary queries. Supabase gives you this string on the project's
  // Database Settings page ("Connection pooling").
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — Prisma Migrate needs this because
  // pgbouncer's transaction pooling mode doesn't support the prepared
  // statements migrations rely on. Same page, "Connection string" (non-pooled).
  directUrl = env("DIRECT_URL")
}

// Postgres has a native enum type, but the enum-like fields below (FacultyRole:
// ADMIN|PROCTOR; SourceType: MAIN|TAL|REVAL|CHALLENGE_REVAL|SUPPLEMENTARY|
// STUDENT_PROVISIONAL; ResultStatus: PASS|FAIL|WITHHELD|ABSENT; ClaimStatus:
// PENDING|APPROVED|REJECTED) are kept as plain strings, validated in the TS
// layer (src/modules/**) instead — carried over unchanged from the SQLite
// schema (which had no native enum type) to keep this migration a pure
// database swap rather than also touching validation logic.

model Faculty {
  facultyId   Int      @id @default(autoincrement()) @map("faculty_id")
  staffId     String   @map("staff_id")
  name        String
  shortCode   String   @unique @map("short_code")
  cabinNo     String?  @map("cabin_no")
  telecomNo   String?  @map("telecom_no")
  phone       String?
  email       String   @unique
  role        String   @default("PROCTOR")

  proctees        Student[]             @relation("ProctorStudents")
  ptmRecords      PtmRecord[]
  claimsReviewed  ActivityPointClaim[]  @relation("ClaimReviewer")
  importBatches   ImportBatch[]
  resultsUploaded ResultRecord[]        @relation("ResultUploader")
  notesAuthored   StudentNote[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  attendanceMarked     AttendanceRecord[] @relation("AttendanceMarker")
  messagesSent         Message[]          @relation("MessageSender")
  messagesReceived     Message[]          @relation("MessageRecipient")
  markRequestsReviewed MarkRequest[]      @relation("MarkRequestReviewer")
  markRequestsAsProctor MarkRequest[]     @relation("MarkRequestProctor")
  circularsSent        Circular[]
  circularsReceived    CircularRecipient[]
  subjectAttendanceUploaded SubjectAttendance[]

  @@map("faculty")
}

// A student-submitted, non-point-bearing record of a standout achievement
// ("national-level swimmer", a hackathon win, a published paper) — distinct
// from ActivityPointClaim, which is specifically the AICTE point-tally
// mechanism with a requested/granted point value and an approval workflow.
// Accolades have neither: there is nothing to approve, only something to
// showcase, so the only lifecycle is "the student posted it" / "it's
// visible to their proctor and the HOD" / "it can be removed" — no status field.
model Accolade {
  id          Int      @id @default(autoincrement())
  usn         String
  title       String
  description String
  category    String? // free-form label the student picks: Sports, Technical, Cultural, Academic, Other
  proofFile   String?  @map("proof_file")
  createdAt   DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [usn], references: [usn])

  @@index([usn])
  @@map("accolade")
}

model Student {
  usn               String   @id
  name               String
  section             String?
  admissionYear       Int      @map("admission_year")
  currentSemester    Int      @default(1) @map("current_semester")
  proctorId           Int?     @map("proctor_id")
  quota                String?
  fatherName         String?  @map("father_name")
  fatherPhone        String?  @map("father_phone")
  motherName         String?  @map("mother_name")
  motherPhone        String?  @map("mother_phone")
  localAddress       String?  @map("local_address")
  localGuardianName  String?  @map("local_guardian_name")
  localGuardianPhone String?  @map("local_guardian_phone")
  email                String   @unique

  proctor      Faculty?             @relation("ProctorStudents", fields: [proctorId], references: [facultyId])
  results      ResultRecord[]
  claims       ActivityPointClaim[]
  ptmRecords   PtmRecord[]
  notes        StudentNote[]
  attendance   AttendanceRecord[]
  accolades    Accolade[]
  markRequests      MarkRequest[]
  subjectAttendance SubjectAttendance[]

  @@map("student")
}

model ResultRecord {
  resultId      Int        @id @default(autoincrement()) @map("result_id")
  usn           String
  subjectCode   String     @map("subject_code")
  subjectName   String?    @map("subject_name")
  semester      Int
  sourceType    String     @map("source_type")
  internalMarks Int?       @map("internal_marks")
  externalMarks Int?       @map("external_marks")
  totalMarks    Int?       @map("total_marks")
  credits       Int        @default(0)
  grade         String?
  status        String     @default("PASS")
  proofFile     String?    @map("proof_file")
  uploadedBy    Int?       @map("uploaded_by")
  uploadedAt    DateTime   @default(now()) @map("uploaded_at")

  student  Student  @relation(fields: [usn], references: [usn])
  uploader Faculty? @relation("ResultUploader", fields: [uploadedBy], references: [facultyId])

  @@map("result_record")
}

model ActivityPointClaim {
  claimId         Int         @id @default(autoincrement()) @map("claim_id")
  usn             String
  proctorId       Int?        @map("proctor_id")
  proofFile       String?     @map("proof_file")
  description     String
  requestedPoints Int         @map("requested_points")
  grantedPoints   Int?        @map("granted_points")
  status          String      @default("PENDING")
  remarks         String?
  semester        Int?
  submittedAt     DateTime    @default(now()) @map("submitted_at")
  reviewedAt      DateTime?   @map("reviewed_at")

  student  Student  @relation(fields: [usn], references: [usn])
  reviewer Faculty? @relation("ClaimReviewer", fields: [proctorId], references: [facultyId])

  @@map("activity_point_claim")
}

model PtmRecord {
  ptmId     Int      @id @default(autoincrement()) @map("ptm_id")
  proctorId Int      @map("proctor_id")
  // Optional — a PTM can be a general slot (null) or tagged to one student,
  // shown on that student's detail page. Nullable rather than required since
  // Section 8.3/Figure 9's original design treats PTM as proctor-level
  // record-keeping, not inherently per-student.
  usn       String?
  ptmDate   String   @map("ptm_date")
  ptmTime   String   @map("ptm_time")
  notes     String?
  // When the record itself was written — distinct from ptmDate/ptmTime, which
  // is the meeting's own date/time and can be backfilled for a past meeting.
  createdAt DateTime @default(now()) @map("created_at")

  proctor Faculty  @relation(fields: [proctorId], references: [facultyId])
  student Student? @relation(fields: [usn], references: [usn])

  @@map("ptm_record")
}

// Not in the original design doc — added so a proctor's per-student
// observations ("spoke to parents about attendance", "recommended for
// scholarship") have somewhere to live beyond a PTM note, and so the report
// card (Section 8, reports/pdf.ts) has real remarks to print instead of
// nothing. Any Admin/Proctor with read access to the student can add one;
// only the author or an Admin can delete it.
model StudentNote {
  id        Int      @id @default(autoincrement())
  usn       String
  authorId  Int      @map("author_id")
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [usn], references: [usn])
  author  Faculty @relation(fields: [authorId], references: [facultyId])

  @@map("student_note")
}

// Not in the original design doc — daily (not per-period) attendance, one
// status per student per calendar date. A per-period/timetable model would
// be far more true to how attendance is actually taken, but nothing in this
// app models periods or a timetable at all; per-day is the smallest addition
// that gives proctors/admins a real attendance percentage without inventing
// a scheduling system this app has no other use for.
model AttendanceRecord {
  id        Int      @id @default(autoincrement())
  usn       String
  date      String // YYYY-MM-DD
  status    String // PRESENT | ABSENT | LATE
  markedBy  Int?     @map("marked_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student  @relation(fields: [usn], references: [usn])
  marker  Faculty? @relation("AttendanceMarker", fields: [markedBy], references: [facultyId])

  @@unique([usn, date])
  @@index([usn])
  @@map("attendance_record")
}

model ImportBatch {
  batchId    Int      @id @default(autoincrement()) @map("batch_id")
  uploadedBy Int      @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  sourceType String   @map("source_type")
  rowCount   Int      @default(0) @map("row_count")
  errorCount Int      @default(0) @map("error_count")
  // Path to the originally-uploaded PDF/image on disk, for scan-import
  // batches only (null for CSV/sheet ingestion, which never had a source
  // file worth keeping). Lets a reviewer go back to the actual scanned sheet
  // if a committed value is ever disputed, instead of trusting the OCR/text
  // extraction blind.
  sourceFile String?  @map("source_file")

  uploader   Faculty           @relation(fields: [uploadedBy], references: [facultyId])
  exceptions ImportException[]

  @@map("import_batch")
}

// Not part of the original ER diagram (Figure 4), which only logs ImportBatch
// metadata. Added so unmatched rows are queryable ("no student is silently
// lost", Section 4.2) rather than only reported once in the upload response.
model ImportException {
  id         Int      @id @default(autoincrement())
  batchId    Int      @map("batch_id")
  rowNumber  Int      @map("row_number")
  rawData    String   @map("raw_data")
  reason     String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  batch ImportBatch @relation(fields: [batchId], references: [batchId])

  @@map("import_exception")
}

// Compliance trail for the real student PII this app holds: who touched
// (viewed/edited/exported) which record, and when. Written by lib/audit.ts,
// called from the routes that read or mutate a specific student/faculty
// record — not every list/search call, which would just be write-volume
// noise without adding accountability value.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  actorRole  String   @map("actor_role")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor Faculty? @relation(fields: [actorId], references: [facultyId])

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_log")
}

// In-app notifications for a faculty member (claim needs review, scan
// exceptions landed, a proctee crossed into at-risk) — a lightweight
// alternative to polling the dashboard. Not part of the original design doc.
model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int      @map("recipient_id")
  type        String
  title       String
  body        String?
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  recipient Faculty @relation(fields: [recipientId], references: [facultyId])

  @@index([recipientId, read])
  @@map("notification")
}

model OtpRequest {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_request")
}

model Session {
  token     String   @id
  email     String
  role      String
  facultyId Int?     @map("faculty_id")
  usn       String?
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("session")
}

// Direct messages between any two Faculty members (proctor <-> proctor,
// proctor <-> HOD/admin) — a lightweight inbox, not a full chat system: a
// flat list of messages, threaded on the frontend by the (sender, recipient)
// pair rather than a separate Conversation table.
model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int      @map("sender_id")
  recipientId Int      @map("recipient_id")
  body        String?
  // A message is either text, an attachment, or both (WhatsApp-style — you
  // can send a photo with no caption) — enforced in the route, not here,
  // since Postgres has no clean single-column "at least one of" check
  // across nullable text + nullable attachment fields.
  attachmentUrl  String? @map("attachment_url")
  attachmentName String? @map("attachment_name")
  attachmentType String? @map("attachment_type")
  attachmentSize Int?    @map("attachment_size")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  sender    Faculty @relation("MessageSender", fields: [senderId], references: [facultyId])
  recipient Faculty @relation("MessageRecipient", fields: [recipientId], references: [facultyId])

  @@index([senderId, recipientId])
  @@index([recipientId, read])
  @@map("message")
}

// A student's request to have one subject's mark re-examined — either a
// formal REVALUATION application (the college re-checks the answer script;
// the student doesn't propose a value) or a CORRECTION claim (the student
// believes the entered mark is simply wrong and states what they think it
// should be), each with optional proof (a photo of the grade card/answer
// script, etc. — same proof-upload mechanism as ActivityPointClaim).
// Reviewed by the student's proctor or an admin; approval writes a *new*
// ResultRecord (sourceType CHALLENGE_REVAL, the highest-precedence tier)
// rather than mutating the disputed row, preserving the append-only
// guarantee the rest of the results system relies on — the old mark stays
// visible in history, just no longer effective.
model MarkRequest {
  id            Int       @id @default(autoincrement())
  usn           String
  // Snapshot of the student's proctor at submission time (same pattern as
  // ActivityPointClaim.proctorId) — scopes a proctor's review queue without
  // a live join, and stays stable even if the student is later reassigned.
  proctorId     Int?      @map("proctor_id")
  subjectCode   String    @map("subject_code")
  subjectName   String?   @map("subject_name")
  semester      Int
  requestType   String    @map("request_type") // REVALUATION | CORRECTION
  // Required for CORRECTION (the student's case for why the mark is wrong);
  // not collected for REVALUATION, which is now just an applied/not-applied
  // marker — the college's external process decides the outcome, not this app.
  reason        String?
  proposedTotal Int?      @map("proposed_total")
  proposedGrade String?   @map("proposed_grade")
  proofFile     String?   @map("proof_file")
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  remarks       String?
  reviewedBy    Int?      @map("reviewed_by")
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  reviewedAt    DateTime? @map("reviewed_at")

  student  Student  @relation(fields: [usn], references: [usn])
  proctor  Faculty? @relation("MarkRequestProctor", fields: [proctorId], references: [facultyId])
  reviewer Faculty? @relation("MarkRequestReviewer", fields: [reviewedBy], references: [facultyId])

  @@index([usn])
  @@index([proctorId, status])
  @@map("mark_request")
}

// A one-to-many notice from the HOD to selected proctors — either authored
// inline (rich-text `body`, rendered to a watermarked PDF on demand, same
// engine as a PTM record) or an uploaded PDF/Word file (`fileUrl`). Exactly
// one of body/fileUrl is set per circular. Per-recipient read tracking lives
// in CircularRecipient rather than reusing Notification, since a circular is
// a first-class document with its own detail view, not just an alert.
model Circular {
  id        Int      @id @default(autoincrement())
  title     String
  body      String?
  fileUrl   String?  @map("file_url")
  fileName  String?  @map("file_name")
  senderId  Int      @map("sender_id")
  createdAt DateTime @default(now()) @map("created_at")

  sender     Faculty             @relation(fields: [senderId], references: [facultyId])
  recipients CircularRecipient[]

  @@map("circular")
}

model CircularRecipient {
  id         Int       @id @default(autoincrement())
  circularId Int       @map("circular_id")
  facultyId  Int       @map("faculty_id")
  read       Boolean   @default(false)
  readAt     DateTime? @map("read_at")

  circular Circular @relation(fields: [circularId], references: [id], onDelete: Cascade)
  faculty  Faculty  @relation(fields: [facultyId], references: [facultyId])

  @@unique([circularId, facultyId])
  @@map("circular_recipient")
}

// Per-subject attendance — separate from AttendanceRecord's day-by-day
// marking (which a proctor does themselves, e.g. a homeroom-style roll
// call). A proctor doesn't teach their proctees' individual subjects, so
// subject-wise attendance is entered by an Admin from what subject faculty
// report elsewhere; proctors only ever view it (Section 9 access matrix).
model SubjectAttendance {
  id              Int      @id @default(autoincrement())
  usn             String
  subjectCode     String   @map("subject_code")
  subjectName     String?  @map("subject_name")
  semester        Int
  totalClasses    Int      @map("total_classes")
  attendedClasses Int      @map("attended_classes")
  uploadedBy      Int?     @map("uploaded_by")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  student  Student  @relation(fields: [usn], references: [usn])
  uploader Faculty? @relation(fields: [uploadedBy], references: [facultyId])

  @@unique([usn, subjectCode, semester])
  @@index([usn])
  @@map("subject_attendance")
}
