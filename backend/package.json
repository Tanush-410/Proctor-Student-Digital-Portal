{
  "name": "proctor-diary-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/assets && cp -r src/assets/. dist/assets/",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "tsx prisma/seedReal.ts",
    "seed:demo": "tsx prisma/seed.ts",
    "seed:build": "tsx prisma/data/buildCohort.ts",
    "seed:export": "tsx prisma/exportCohort.ts",
    "bootstrap-admin": "node dist/scripts/bootstrapAdmin.js",
    "test": "bash scripts/test.sh",
    "seed:scale": "tsx prisma/seedScale.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "htmlparser2": "^12.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0",
    "prisma": "^5.20.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
