# Copy to backend/.env for local dev (gitignored — never commit real
# credentials). Get both connection strings from Supabase: Project Settings
# -> Database -> Connection string.

# Pooled (pgbouncer, port 6543) — what the running app uses. Add
# ?pgbouncer=true to the string Supabase gives you if it isn't already there.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (non-pooled, port 5432) — used only by `prisma migrate dev`/`deploy`.
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# A SEPARATE Postgres database for the test suite — `npm test` runs
# `prisma db push --force-reset` against this, which drops every table.
# Never point this at the same database as DATABASE_URL. Cheapest options:
# a second free Supabase project, or a local Postgres (e.g.
# `docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=test postgres:16`).
TEST_DATABASE_URL="postgresql://postgres:test@localhost:5432/proctor_diary_test"

PORT=4000
UPLOADS_DIR=uploads
CORS_ORIGIN=http://localhost:5173

# Leave unset in dev — OTP codes are echoed in the API response instead
# (see README "Security"). Set all five to send real e-mail (also used for
# notification e-mails — claim-submitted, at-risk — once SMTP is configured).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Public URL of the deployed app, e.g. https://proctor-diary.onrender.com —
# used only to build the "Open in Proctor Diary" link in a notification
# e-mail. Leave unset in dev; the e-mail just omits the link.
# APP_URL=
